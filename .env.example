# Copie este arquivo para .env na raiz do projeto e substitua os valores.
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/mente?retryWrites=true&w=majority
PORT=3000
NODE_ENV=development

# Configuração pública do aplicativo Web cadastrada no Firebase Console.
FIREBASE_API_KEY=<api-key-publica>
FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
FIREBASE_PROJECT_ID=<project-id>
FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=<sender-id>
FIREBASE_APP_ID=<app-id>

# Caminho local para a chave da conta de serviço do Firebase Admin.
# O arquivo JSON também é ignorado pelo Git. Em ambientes Google, use ADC.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
